# 复制为 deploy/.env 后填写，并执行 chmod 600 deploy/.env
# 不要提交真实密码

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=shiguangji
MYSQL_USER=shiguangji
MYSQL_PASSWORD=change-me-db

# 至少 32 字节随机值，例如 openssl rand -base64 48
JWT_SECRET=change-me-64-random

# 首次启动创建管理员，创建成功后可改为 false
APP_BOOTSTRAP_ENABLED=true
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me-admin

# 上传目录的宿主机父目录
DATA_DIR=/data/shiguangji
